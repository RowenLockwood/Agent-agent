# Neon Postgres connection string.
# Get one at https://console.neon.tech — copy the "Pooled connection" URL.
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# OpenAI — powers the Payment Email "Edit Email" (revision) feature.
# Server-side only; the key is never sent to the browser.
OPENAI_API_KEY="your-openai-api-key"
# Model used to revise emails (OpenAI Responses API, reasoning effort: high).
# Override here if gpt-5.5 isn't available on your account.
OPENAI_MODEL="gpt-5.5"

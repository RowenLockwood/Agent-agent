// Plato — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Author {
  id                    String   @id @default(cuid())
  firstName             String
  lastName              String
  title                 String
  genre                 String
  email                 String
  headAgent             String
  headAgentEmail        String
  assignedAssistant     String

  // Author-level publishing pipeline stages
  // Values: "not_started" | "in_progress" | "completed"
  authorOnboarded       String   @default("not_started")
  proposalSentToEditors String   @default("not_started")
  authorMeetings        String   @default("not_started")
  bidSent               String   @default("not_started")
  dealMemoSent          String   @default("not_started")
  dealMemoAccepted      String   @default("not_started")
  paymentReceived       String   @default("not_started")
  paymentSentToAuthor   String   @default("not_started")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  editorOutreach        EditorOutreach[]
  paymentDetails        AuthorPaymentDetails?

  @@index([createdAt])
}

model EditorOutreach {
  id          String  @id @default(cuid())
  authorId    String
  author      Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  editorFirstName  String
  editorLastName   String
  editorEmail      String
  publishingHouse  String

  // Editor-level stage values — each stage has its own allowed set (see src/lib/stages.ts)
  proposalStage            String @default("not_sent")
  authorMeetingStage       String @default("not_sent")
  bidStage                 String @default("not_sent")
  dealMemoStage            String @default("not_sent")
  paymentReceivedStage     String @default("not_received")
  paymentSentToAuthorStage String @default("not_sent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

// Single-row settings table; the only row uses id = "singleton".
model AppSettings {
  id         String   @id
  agencyName String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// One row per author. Houses the contract/payment progression plus the
// commission & royalty terms shown in the Client Library's Payment Details
// dropdown. The stage values share the author-level vocabulary
// ("not_started" | "in_progress" | "completed"), and the dollar/percent/date
// fields stay null until Contract Details unlocks.
model AuthorPaymentDetails {
  id       String @id @default(cuid())
  authorId String @unique
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  contractSentToEditorStage       String @default("not_started")
  backAndForthWithEditorStage     String @default("not_started")
  contractSignedByAuthorStage     String @default("not_started")
  contractSignedByEditorStage     String @default("not_started")
  contractSignedByAllPartiesStage String @default("not_started")
  paymentReceivedFromEditorStage  String @default("not_started")
  paymentSentToAuthorStage        String @default("not_started")

  commissionAmount           Float?
  commissionPercentForAgency Float?

  firstRoyaltyStatementDate DateTime?
  renewalIntervalNumber     Int?
  renewalIntervalUnit       String? // "weeks" | "months"
  lastSentToAuthorDate      DateTime?
  nextSendToAuthorDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Payment Email templates ──────────────────────────────────────────────────

// A saved Payment Email template. The body is stored as a tokenized JSON
// segment list ({"t":"text","v":…} | {"t":"field","k":…}) so field references
// survive label changes and render through one safe plain-text path; a
// plain-text fallback (tokens shown as "[Label]") is stored alongside for
// resilience. The Plato system default lives at a fixed id and is protected
// from edits and deletion; user versions point back through parentTemplateId.
model PaymentEmailTemplate {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  subjectLine String?

  tokenizedBody         String
  plainTextBodyFallback String

  isSystemDefault Boolean @default(false)
  isAgencyDefault Boolean @default(false)
  isActive        Boolean @default(true)

  versionNumber    Int     @default(1)
  parentTemplateId String?
  parentTemplate   PaymentEmailTemplate?  @relation("PaymentEmailTemplateVersions", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  childVersions    PaymentEmailTemplate[] @relation("PaymentEmailTemplateVersions")

  customFields     PaymentEmailCustomField[]
  calculatedFields PaymentEmailCalculatedField[]
  summaryFields    PaymentEmailSummaryField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentTemplateId])
  @@index([createdAt])
}

// Agency-created input field scoped to one template. fieldType:
// "short_text" | "long_text" | "dropdown" | "number" | "currency" | "percentage".
// dropdownOptions holds a JSON string array when fieldType = "dropdown".
model PaymentEmailCustomField {
  id         String               @id @default(cuid())
  templateId String
  template   PaymentEmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  fieldKey        String
  label           String
  fieldType       String
  isRequired      Boolean @default(false)
  placeholder     String?
  defaultValue    String?
  dropdownOptions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, fieldKey])
}

// Agency-defined calculated field scoped to one template. expressionTree is a
// validated structured JSON expression (field refs + add/subtract/multiply/
// divide/percent-of nodes) — never executable code. outputType:
// "number" | "currency" | "percentage". Summary-row membership lives solely in
// PaymentEmailSummaryField; no summary flags are duplicated here.
model PaymentEmailCalculatedField {
  id         String               @id @default(cuid())
  templateId String
  template   PaymentEmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  fieldKey       String
  label          String
  outputType     String
  expressionTree String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, fieldKey])
}

// Single source of truth for a template's summary row (the strip above
// "Generate Email"). Up to four entries per template, ordered by displayOrder.
model PaymentEmailSummaryField {
  id         String               @id @default(cuid())
  templateId String
  template   PaymentEmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  fieldKey     String
  summaryLabel String
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, fieldKey])
}
